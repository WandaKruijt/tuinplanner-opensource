# Environment voor de demomodus (vite --mode demo / npm run dev:demo).
# Dit bestand bevat GEEN geheimen en hoort in git.
#
# In demomodus draait de app zonder Firebase: de firebase-modules worden
# vervangen door in-memory shims (zie vite.config.ts en src/demo/).

VITE_DEMO_MODE=true
VITE_GARDEN_NAME=Demo Gemeenschapstuin
VITE_ADMIN_EMAILS=demo-admin@example.com
VITE_COMMUNITY_EMAIL=demo@example.com

# Dummywaarden zodat de config-validatie niet klaagt; ze worden in
# demomodus nergens voor gebruikt.
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=demo
VITE_FIREBASE_DATABASE_URL=https://demo.example.com
VITE_FIREBASE_PROJECT_ID=demo
VITE_FIREBASE_STORAGE_BUCKET=demo
VITE_FIREBASE_MESSAGING_SENDER_ID=demo
VITE_FIREBASE_APP_ID=demo

# TuinPlanner configuratie
# Kopieer dit bestand naar .env en vul de waarden in.
# Op Vercel (of andere hosting) stel je dezelfde variabelen in als
# Environment Variables. Zie SETUP.md voor stap-voor-stap uitleg.

# ----- Jouw tuin -----

# Naam van de tuin, getoond op het loginscherm en in de handleiding
VITE_GARDEN_NAME=

# E-mailadressen met adminrechten, kommagescheiden.
# LET OP: vul hetzelfde adres in firebase-rules.template.json in en
# publiceer die regels in Firebase, anders werken de adminrechten niet.
VITE_ADMIN_EMAILS=

# E-mailadres van het gedeelde community-account (maak dit account aan
# in Firebase Authentication)
VITE_COMMUNITY_EMAIL=

# ----- Firebase (uit de Firebase Console, projectinstellingen) -----

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ----- Optioneel -----

# DeepL API-sleutel voor automatische NL->EN vertaling van gebruikerstekst.
# Zonder sleutel blijft de app gewoon werken; er wordt dan niet vertaald.
# Gratis sleutel aan te vragen op https://www.deepl.com/pro-api
VITE_DEEPL_API_KEY=
